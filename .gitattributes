* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.cmd text eol=crlf
*.png binary
*.pdf binary
# Research snapshots preserve the exact bytes used by their recorded SHA-256.
docs/results/*.json -text
docs/ie-results/*.json -text
docs/medical-results/*.json -text whitespace=cr-at-eol
# Keep the v0.7 entrypoint bytes captured by its immutable Windows protocol.
scripts/compare_medical_relations.py -text -eol whitespace=cr-at-eol
scripts/compare_medical_gp_loss.py -text -eol whitespace=cr-at-eol
nlp_lab/medical/joint_train.py whitespace=-blank-at-eof
